# Copiar a .env y completar. Nunca commitear .env.
# RPC de Arbitrum (lecturas de Morpho y Curve).
ARBITRUM_RPC_URL=
# RPC de Avalanche Fuji (contrato de la demo).
FUJI_RPC_URL=
# Clave de la billetera de prueba que despliega. Sólo testnet o montos chicos.
DEPLOYER_PRIVATE_KEY=
# KYB de KUMPLY, si dan acceso.
KUMPLY_API_KEY=
# Opcional: modelo de lenguaje para redactar la explicación del agente.
ANTHROPIC_API_KEY=
